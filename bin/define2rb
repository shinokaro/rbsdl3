#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"

NL = /(\r\n|\r|\n)/
BLOCK_COMMENT = /\/\*(?~\*\/)\*\//
TYPE = /(?:size_t|[SU]int\d+|SDL_\w+)/
UNARY = /[+\-~!]*/
HEX   = /0[xX]\h+/
OCT   = /0[0-7]*/
DEC   = /\d+/
IDENT = /[A-Za-z_][A-Za-z0-9_]*/
CHAR  = /'(?:\\.|[^'\\])'/
ATOM  = /(?:#{HEX}|#{OCT}|#{DEC}|#{IDENT}|#{CHAR})/

INT_SUFFIX_RE = /\b(#{HEX}|#{OCT}|#{DEC})(?:[uU](?:ll|LL|l|L)?|(?:ll|LL|l|L)[uU]?)\b/
FLOAT_SUFFIX_RE = /(?<!\w)((?:(?:#{DEC})*\.#{DEC}|#{DEC}\.|#{DEC})(?:[eE][+-]?#{DEC})?)[fFlL]\b/
CAST_PAREN_EXPR_RE = /\((\s*#{TYPE}\s*)\)\(/
CAST_SIMPLE_OPERAND_RE = /\((\s*#{TYPE}\s*)\)\s*(#{UNARY})\s*(#{ATOM})/
PP_DEFINE_RE = /\A\s*#\s*define\s+/

SDL_NAME = /\bSDL_[0-9A-Za-z_]+\b/

def normalize_macro_expr(s)
  s = s.dup
  s.gsub!(INT_SUFFIX_RE, '\1')
  s.gsub!(FLOAT_SUFFIX_RE, '\1')
  s.gsub!(CAST_PAREN_EXPR_RE, '\1(')
  s.gsub!(CAST_SIMPLE_OPERAND_RE, '\1(\2\3)')
  s
end

def row2rb(line)
  case line
  in /\\#{NL}\z/
    raise "Line continuation detected ('\' + newline)"

  in /#{PP_DEFINE_RE}(?<name>#{SDL_NAME})(?!\()\s+(?<value>.*\S)\s*\z/
    name, value = Regexp.last_match.values_at(:name, :value)
    value = normalize_macro_expr(value)
    
    "const_set :#{name}, #{value}"

  in /#{PP_DEFINE_RE}(?<name>#{SDL_NAME})\((?<params>[^)]*)\)\s+(?<body>.*\S)\s*\z/
    name, params, body = Regexp.last_match.values_at(:name, :params, :body)
    unless (param_names = params.scan(/[A-Za-z_]\w*/)).empty?
      re = Regexp.union(param_names.map { /\b#{Regexp.escape(_1)}\b/ })
      params.gsub!(re, &:downcase)
      body.gsub!(re, &:downcase)
    end

    body = normalize_macro_expr(body)
    body.gsub!(/->/, '.')
    body.gsub!(/\s+/, ' ')

    "module_function def #{name}(#{params}) = #{body}"

  else
    nil
  end
end

ARGV.each do |path|
  src = File.binread(path)
  
  clean = src.gsub(BLOCK_COMMENT, "")
  spliced = clean.gsub(/\\#{NL}/, "")

  defined = spliced.each_line.map { |line|
    row2rb(line)
  }.compact
  next if defined.empty?
  puts defined.join($/)
end
